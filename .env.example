GOOGLE_GENAI_USE_VERTEXAI=FALSE
GOOGLE_API_KEY=your-gemini-key
GEMINI_API_KEY=your-gemini-key
MODEL=gemini-2.5-flash

# Optional
# Shared token between planner and specialists (compose passes .env to every service).
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
# MESH_TOKEN=
# MAX_SESSION_COST_USD=0.50
# A2A_TIMEOUT_S=120
# SPECIALIST_CACHE_TTL_S=300
# MAX_CONCURRENCY=4
# RETRY_ATTEMPTS=2
# HANDLER_TIMEOUT_S=60
# BREAKER_THRESHOLD=3
# BREAKER_COOLDOWN_S=30
# MAX_TOOL_REPLY_CHARS=6000
# MESH_REGISTRY=registry.example.json
# MAX_INPUT_CHARS=4000
# PRICE_IN_PER_M=0.30
# PRICE_OUT_PER_M=2.50
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# MESH_TRACE_CONSOLE=1
